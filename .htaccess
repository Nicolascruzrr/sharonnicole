# Clean URLs for Sharon Nicole site (Apache / Hostinger / cPanel)
Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Redirect old .html course URLs to clean folder URLs
RewriteRule ^curso-sueno-desde-cero\.html$ /curso-sueno-desde-cero/ [R=301,L]
RewriteRule ^curso-noches-completas\.html$ /curso-noches-completas/ [R=301,L]
RewriteRule ^curso-agenda-acompanamiento\.html$ /curso-agenda-acompanamiento/ [R=301,L]
RewriteRule ^curso-el-arte-de-dormir\.html$ /curso-el-arte-de-dormir/ [R=301,L]

# Optional: hide index.html on home
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
